MONGODB_URI="MONGO_DB"
PORT=4000
PUBLIC_BASE_URL="https://quantalog-be.daorbit.in"
JWT_SECRET="a-long-random-secret"

SMTP_USER="daorbit2k25@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="daorbit2k25@gmail.com"
SMTP_FROM_NAME="Quantalog"

CLOUDINARY_CLOUD_NAME="YOUR_PASS"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
RAZORPAY_KEY_ID="YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

INVOICE_SELLER_NAME="DaOrbit"
INVOICE_SELLER_ADDRESS="Rohtak, Haryana 124001, India"
INVOICE_SELLER_EMAIL="daorbit2k25@gmail.com"

# exchangerate-api.com — powers the nightly USD reprice and the admin
# "Sync USD prices" button.
EXCHANGERATE_API_KEY="YOUR_API_KEY"

# Vercel Cron calls /api/cron/fx-sync with this as a bearer token. Set it in the
# Vercel dashboard too — without it the endpoint fails closed and never runs.
CRON_SECRET="A_LONG_RANDOM_STRING"

# Where the nightly reprice report goes, on success and on failure alike.
# Defaults to SMTP_USER if unset.
FX_REPORT_EMAIL="daorbit2k25@gmail.com"

# In-process nightly reprice, for a long-running host or `npm run dev` only.
# Leave unset on Vercel: the schedule there is the `crons` entry in vercel.json,
# and a serverless process never lives long enough for a timer to fire.
FX_CRON_ENABLED="false"
FX_CRON_SCHEDULE="30 2 * * *"
FX_CRON_TZ="UTC"

# WhatsApp delivery via WireWeb (unofficial gateway — see lib/whatsapp.ts).
# Base URL is required: their published docs use a placeholder host.
WIREWEB_BASE_URL="https://app.wireweb.co.in/api"
WIREWEB_API_KEY="YOUR_API_KEY"
WIREWEB_SESSION_ID="ws_xxxxxxxx"

GEMINI_API_KEY="XXX"

# LinkedIn: connecting a member's profile from the Share Panel, publishing to it,
# and "Continue with LinkedIn" on the login and signup pages.
#
# All three belong to the API deployment only. The secret must never reach the
# frontend project, and the frontend needs no LinkedIn variables of its own.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Must match an entry under "Authorized redirect URLs" in the LinkedIn app byte
# for byte. It points at this API, not the studio: exchanging the code for a
# token requires the client secret, so only the server can complete the flow.
# Falls back to `${PUBLIC_BASE_URL}/api/auth/linkedin/callback` when unset — but
# one of the two must be set, or the flow reports itself as not configured.
LINKEDIN_REDIRECT_URI="https://quantalog-be.daorbit.in/api/auth/linkedin/callback"
# Where the flow sends the browser back to. Defaults to the production studio.
STUDIO_BASE_URL="https://studio-quantalog.daorbit.in"
# LinkedIn retires dated API versions on a rolling window; bump when re-checked.
LINKEDIN_API_VERSION="202506"
# Encrypts stored LinkedIn access tokens. Falls back to JWT_SECRET when unset —
# changing either makes existing stored tokens undecryptable, and affected users
# simply have to reconnect.
TOKEN_ENCRYPTION_KEY=""

# Cloudflare Turnstile — the login form's bot challenge. Server-side secret,
# never exposed to the browser; the matching public sitekey lives in the
# frontend's env as CLOUDFLARE_SITE_KEY. When this is unset, /api/auth/login
# skips verification entirely so a local checkout still logs in.
CLOUDFLARE_SECRET_KEY=""
