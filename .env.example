# exchangerate-api.com — powers the nightly USD reprice and the admin
# "Sync USD prices" button.
EXCHANGERATE_API_KEY="YOUR_API_KEY"
 
CRON_SECRET="A_LONG_RANDOM_STRING"

# Forms service (da-forms). The secret must match FORMS_SERVICE_SECRET there.
FORMS_API_BASE="https://forms.daorbit.in"
FORMS_SERVICE_SECRET="a-long-random-shared-secret"

# Claude / MCP connector. Off unless MCP_ENABLED is "true".
MCP_ENABLED="false"
# Public origin of this API; the MCP endpoint is <issuer>/mcp. Defaults to PUBLIC_BASE_URL.
MCP_ISSUER_URL="https://quantalog-be.daorbit.in"
# Dashboard origin hosting the consent page (/connect/authorize). Defaults to STUDIO_BASE_URL.
MCP_CONSENT_URL="https://studio-quantalog.daorbit.in"
# Hosts allowed as OAuth redirect targets for dynamically registered clients.
MCP_ALLOWED_REDIRECT_HOSTS="claude.ai,claude.com,chatgpt.com,chat.openai.com"
# Allow http://localhost redirect URIs in production (MCP Inspector, local clients).
MCP_ALLOW_LOOPBACK_REDIRECTS="false"

# Where the nightly reprice report goes, on success and on failure alike.
# Defaults to SMTP_USER if unset.
FX_REPORT_EMAIL="daorbit2k25@gmail.com"

 
FX_CRON_ENABLED="false"
FX_CRON_SCHEDULE="30 2 * * *"
FX_CRON_TZ="UTC"

 
WIREWEB_BASE_URL="https://app.wireweb.co.in/api"
WIREWEB_API_KEY="YOUR_API_KEY"
WIREWEB_SESSION_ID="ws_xxxxxxxx"

