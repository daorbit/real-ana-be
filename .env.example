GEMINI_API_KEY="XXX"

# LinkedIn: connecting a member's profile from the Share Panel, publishing to it,
# and "Continue with LinkedIn" on the login and signup pages.
#
# All three belong to the API deployment only. The secret must never reach the
# frontend project, and the frontend needs no LinkedIn variables of its own.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
 
LINKEDIN_REDIRECT_URI="https://quantalog-be.daorbit.in/api/auth/linkedin/callback"
# Where the flow sends the browser back to. Defaults to the production studio.
STUDIO_BASE_URL="https://studio-quantalog.daorbit.in"
# LinkedIn retires dated API versions on a rolling window; bump when re-checked.
LINKEDIN_API_VERSION="202506"
 
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# The Meta app-level credentials. Read only as a fallback for the pair above.
META_APP_ID=""
META_APP_SECRET=""
# Must match the value registered under the Instagram app's OAuth redirect URIs
# byte for byte. Note there is no `/api` prefix — the path registered with Meta
# is the bare one, and `app.ts` mounts the router at both.
INSTAGRAM_REDIRECT_URI="https://quantalog-be.daorbit.in/auth/instagram/callback"
# Registered in the Meta dashboard. Not read by the code — the routes serve these
# paths regardless — but kept here so the deployment records what Meta was told.
INSTAGRAM_DEAUTH_URL="https://quantalog-be.daorbit.in/auth/instagram/deauthorize"
INSTAGRAM_DATA_DELETION_URL="https://quantalog-be.daorbit.in/auth/instagram/data-deletion"
INSTAGRAM_API_VERSION="v23.0"
 
TOKEN_ENCRYPTION_KEY=""
 
CLOUDFLARE_SECRET_KEY=""
