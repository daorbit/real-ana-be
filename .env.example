MONGODB_URI="MONGO_DB"
PORT=4000
PUBLIC_BASE_URL="https://quantalog-be.daorbit.in"
JWT_SECRET="a-long-random-secret"

# Outbound email (Gmail SMTP). SMTP_PASS must be a Google App Password,
# generated at https://myaccount.google.com/apppasswords — the normal account
# password is rejected once 2FA is on.
SMTP_USER="daorbit2k25@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="daorbit2k25@gmail.com"
SMTP_FROM_NAME="Quantalog"

CLOUDINARY_CLOUD_NAME="YOUR_PASS"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
RAZORPAY_KEY_ID="YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# Razorpay Plan ids (Dashboard -> Subscriptions -> Plans), one per paid tier
# per billing cycle. The plan catalogue itself (quotas, limits, features) is
# fixed in src/plans.ts — these are the only per-plan values read from env.
RAZORPAY_PLAN_STARTER_MONTHLY=""
RAZORPAY_PLAN_STARTER_YEARLY=""
RAZORPAY_PLAN_PRO_MONTHLY=""
RAZORPAY_PLAN_PRO_YEARLY=""